rules_version = '2';

// Ders görselleri ve videoları: giriş yapmış herkes görür, sadece
// Kahve Operasyonu yükler. Görsel 10 MB, video 200 MB ile sınırlı.
service firebase.storage {
  match /b/{bucket}/o {
    match /lessons/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role in ['ops', 'admin']
        && (
          (request.resource.contentType.matches('image/.*') && request.resource.size < 10 * 1024 * 1024) ||
          (request.resource.contentType.matches('video/.*') && request.resource.size < 200 * 1024 * 1024)
        );
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
