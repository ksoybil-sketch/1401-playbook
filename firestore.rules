rules_version = '2';

// 1401 Campus — Firestore güvenlik kuralları (Spark / ücretsiz plan).
//
// Sunucu kodu (Cloud Functions) ve Storage yok — bkz. blaze/ için Blaze
// sürümü. Ders fotoğrafları, küçültülüp data URL olarak doğrudan
// lessons/{id}.blocks içine yazılır (ayrı bir koleksiyon yok).
// Kimlik custom claim'lerden değil, users/{uid} belgesindeki `role`
// alanından okunur; her hesap (mağaza telefonu, barista, yönetici) kendi
// Firebase Auth kullanıcısıdır (bkz. src/api/backend.ts).
//
// Bilinen kısıtlar (Blaze'e geçince kalkar — bkz. blaze/README.md):
//  - Sınav soru bankası (cevap anahtarı dahil) mağaza oturumlarına açıktır;
//    puanlama telefonda yapılır.
//  - Sınav sonucu (progress.modules) doğrudan barista hesabınca yazılır.
//  - Telefon eşleştirme kodu, kullanana kadar şifreyi düz metin taşır.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    /** users/{uid} belgem — yoksa okuma hata verir, kural reddeder. */
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    /**
     * Etkin hesap: users/{uid} belgesi var ve active == true.
     * Pasifleştirilen hesap (ekipten kaldırılan yönetici, bağlantısı
     * kaldırılan telefon, pasif barista, PIN'i sıfırlanınca eski hesap)
     * Firebase Auth jetonu yenilenmeye devam etse de hiçbir şey okuyup
     * yazamaz. İstisna: kendi users/{uid} belgesini okuması (uygulama
     * bununla "erişimin kaldırıldı" deyip oturumu kapatır), ilk kurulum
     * (bootstrap) ve hata kaydı.
     */
    //
    // Pasif mağaza tamamen kapalıdır (H7, 15.11.2026 kullanıcı kararı): mağaza
    // telefonu ve o mağazanın baristaları hiçbir şey okuyup yazamaz. Kendi
    // users belgesi ve kendi mağaza belgesi okunur (uygulama "mağaza pasif"
    // ekranını gösterir). Mağaza belgesi yoksa (eski kayıt) açık sayılır.
    function isActive() {
      return signedIn() && me().get('active', false) == true
        && (!(me().get('role', '') in ['store', 'barista', 'lead', 'shift']) || storeOpen(me().get('storeId', '')));
    }
    function storeOpen(sid) {
      let p = /databases/$(database)/documents/stores/$(sid);
      return !exists(p) || get(p).data.get('active', true) != false;
    }
    /**
     * Sunucu saatine yakın zaman (ms, ± tol). Telefonun saati yanlış olsa da
     * kayıtlara sunucu saati yazılsın (H1, H2; istemci lib/serverTime.ts ile düzeltir).
     */
    function nearNow(t, tol) {
      return t is number && t >= request.time.toMillis() - tol && t <= request.time.toMillis() + tol;
    }
    function myRole() { return isActive() ? me().role : null; }
    // Yetki sıralaması — bkz. src/lib/roles.ts (ikisi birlikte değişmeli).
    //   developer  uygulama geliştiricisi; dağıtıma kadar hiçbir kurala takılmaz
    //   director   Kahve Operasyon Direktörü: yayınlar, onaylar, ekibi yönetir
    //   regional   Bölge Müdürü: barista/mağaza/kod işleri, talepler
    //   board      Yönetim Kurulu üyesi: her şeyi okur, hiçbir şey yazmaz
    //              (yalnızca kurul sorusu sorar). isStaff() kurulu KAPSAMAZ:
    //              yazma izinleri isStaff() üzerinden verildiği için kurul
    //              okuma kurallarına ayrıca (canRead) eklenir.
    function isStaff() { return myRole() in ['developer', 'director', 'opsmanager', 'regional']; }
    function isBoard() { return myRole() == 'board'; }
    /**
     * Pazarlama & Kreatif (24.11.2026): bülteni, mağaza taleplerini ve
     * akademiyi OKUR. isStaff() bu rolü KAPSAMAZ — yazma izinleri isStaff()
     * üzerinden verildiği için akademide hiçbir şeyi değiştiremez, öneri
     * (proposals) bile açamaz. Tek yazdığı yer: kendi konusundaki talepler
     * (reqCats, canHandleRequests).
     */
    function isMarketing() { return myRole() == 'marketing'; }
    /** Okuma: Kahve Operasyonu, Pazarlama & Kreatif ve Yönetim Kurulu. */
    function canRead() { return isStaff() || isBoard() || isMarketing(); }
    // --- Ayarlanabilir yetkiler (src/lib/permissions.ts) ------------------
    // config/permissions.roles[rol][yetki] = true/false. Belge ya da satır
    // yoksa her yetkinin yanında yazan varsayılan rol listesi geçerlidir
    // (permissions.ts DEFAULTS ile aynı — ikisi birlikte değişmeli).
    // Geliştirici ayarlardan etkilenmez.
    // Yönetim Kurulu yalnızca "kurul.*" yetkilerini alabilir (kurul ekranları,
    // kurul sorusu sormak): Yetkiler belgesine kurul için başka bir yetki
    // yazılsa da (ör. roles.board.icerikYayin) kural onu yok sayar. Kurul
    // salt okunur ilkesi ayarla delinmesin (güvenlik raporu K-8).
    function permDoc() { return /databases/$(database)/documents/config/permissions; }
    function perm(cap, defaults) {
      let r = myRole();
      let o = exists(permDoc()) ? get(permDoc()).data.get('roles', {}) : {};
      return r == 'developer'
        || ((r != 'board' || cap.matches('kurul[.].*'))
            && ((r in o && cap in o[r]) ? o[r][cap] == true : r in defaults));
    }
    /** Rolün içerik alanı: izinli eğitim yolları; null = her yer. */
    function domainLimit() {
      let r = myRole();
      let d = exists(permDoc()) ? get(permDoc()).data.get('domains', {}) : {};
      return r == 'developer' ? null
        : (r in d ? d[r] : (r == 'opsmanager' ? ['oryantasyon', 'misafir-deneyimi', 'isletme-standartlari'] : null));
    }
    /** Modülün yolu: aynı toplu yazımda yeni açılan modül için yazım sonrası hâli. */
    function trackOf(mid) {
      let p = /databases/$(database)/documents/modules/$(mid);
      return exists(p) ? get(p).data.trackId : getAfter(p).data.trackId;
    }
    function inTrack(trackId) { let lim = domainLimit(); return lim == null || trackId in lim; }
    function inModule(mid) { let lim = domainLimit(); return lim == null || trackOf(mid) in lim; }
    /** Yazılan belge: silmede eski hâli. */
    function docData() { return request.resource != null ? request.resource.data : resource.data; }

    // --- Boyut ve içerik sınırları (güvenlik raporu K-5) -------------------
    // Spark planında sunucu doğrulaması yok: tek bir hesabın belgeleri 1 MiB'a
    // kadar şişirip kotayı tüketmesini ve yöneticinin ekranına dış adresli
    // izleme pikseli koymasını kurallar keser. Sınırlar arayüzdeki gerçek
    // kullanımın birkaç katı; mevcut kayıtları kırmaz.
    /** Alan yoksa ya da n karakteri aşmayan metinse. */
    function strMax(d, k, n) { return !(k in d) || (d[k] is string && d[k].size() <= n); }
    /** Alan yoksa ya da n öğeyi aşmayan listeyse. */
    function listMax(d, k, n) { return !(k in d) || (d[k] is list && d[k].size() <= n); }
    /**
     * Görsel: yok, boş ya da uygulamanın kendi yüklediği data URL'i
     * (src/lib/media.ts compressImage). Dış http(s) adresi reddedilir.
     */
    function imgOk(d) {
      return !('imageUrl' in d) || d.imageUrl == null
        || (d.imageUrl is string && (d.imageUrl == '' || d.imageUrl.matches('data:image/(jpeg|png|webp|gif);base64,[A-Za-z0-9+/=]*')));
    }
    /** Güncellemede görsel değişmediyse eski kayıt olduğu gibi kalır (eski kayıtlar kırılmasın). */
    function imgWriteOk() {
      return request.resource == null
        || (resource != null && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['imageUrl']))
        || imgOk(request.resource.data);
    }
    /** Silmede sınır yok; yazımda d (yazım sonrası hâl) denetlenir. */
    function onWrite() { return request.resource != null; }
    /**
     * Yalnızca sona ekleme: yeni liste eskisinin aynısı + tek öğe; eklenen
     * öğe bu tarafın (side) ve oturum sahibinin. Eski öğeler aynen korunur
     * (güvenlik raporu K-4: talep geçmişine sahte not).
     */
    function appended(newL, oldL, side, maxText) {
      return newL is list && newL.size() == oldL.size() + 1
        && (oldL.size() == 0 || newL[0:oldL.size()] == oldL)
        && newL[oldL.size()].side == side
        && newL[oldL.size()].by == request.auth.uid
        && newL[oldL.size()].text is string && newL[oldL.size()].text.size() <= maxText
        && strMax(newL[oldL.size()], 'byName', 120);
    }
    /** YYYYAAGG (UTC) — hata kaydı kimliği için. */
    function ymd(t) {
      return string(t.year()) + (t.month() < 10 ? '0' : '') + string(t.month()) + (t.day() < 10 ? '0' : '') + string(t.day());
    }

    // Varsayılan rol listeleri (yetki → kimde açık)
    function canPublish() { return perm('icerikYayin', ['director', 'opsmanager']); }
    function canFixQuestions() { return perm('soruDuzelt', ['director', 'opsmanager']); }
    function canApproveProposals() { return perm('oneriOnay', ['director', 'opsmanager']); }
    function canPublishBulletin() { return perm('bultenYayin', ['director', 'opsmanager']); }
    function canAssign() { return perm('gorevAtama', ['director', 'opsmanager', 'regional']); }
    function canBadges() { return perm('rozetAyar', ['director']); }
    function canNotifications() { return perm('ekran.bildirimler', ['director']); }
    function canFeedback() { return perm('ekran.geriBildirim', ['director', 'opsmanager', 'regional']); }
    /** Kurul sorularını görür / yanıtlar. */
    function seesBoard() { return perm('ekran.kurulSorulari', ['director', 'opsmanager', 'regional']); }
    function answersBoard() { return perm('kurulYanit', ['director', 'opsmanager', 'regional']); }
    /** Geri dönüşsüz işler (sınav kaydı silmek) ve rol üstü her şey. */
    function isAdmin() { return myRole() == 'developer'; }
    /** İçeriği ve bülteni doğrudan yayınlar, önerileri onaylar. */
    function isDirector() { return myRole() in ['developer', 'director']; }
    /** Barista, mağaza telefonu ve davet kodları. */
    function canManageBaristas() { return perm('baristaYonetim', ['regional']); }
    /**
     * Rolün talep konuları (src/lib/permissions.ts DEFAULT_CATS ile aynı —
     * ikisi birlikte değişmeli). config/permissions.cats[rol] ile değiştirilir;
     * null ya da yoksa bütün konular.
     */
    function reqCats() {
      let r = myRole();
      let c = exists(permDoc()) ? get(permDoc()).data.get('cats', {}) : {};
      return r == 'developer' ? null
        : (r in c ? c[r] : (r == 'marketing' ? ['tabela', 'pano', 'baski'] : null));
    }
    function inReqCat(cat) { let lim = reqCats(); return lim == null || cat in lim; }
    /** Mağaza taleplerini yanıtlar, durumunu değiştirir ya da servis onayı verir. */
    function canHandleRequests() { return perm('talepYanit', ['director', 'opsmanager', 'regional', 'marketing']) || perm('servisOnay', ['director', 'opsmanager']); }
    function canApproveService() { return perm('servisOnay', ['director', 'opsmanager']); }
    function isStoreSession() { return myRole() in ['store', 'barista', 'lead', 'shift']; }
    // "Evde ders çalış" girişi (derslikKodlari): yalnızca kendi mağazasının
    // barista listesini okur. isStoreSession'a DAHİL DEĞİLDİR: talep açamaz,
    // sınav başlatamaz, ilerleme yazamaz, reçete/ders dışında bir şey göremez.
    function isDerslik() { return myRole() == 'derslik'; }
    function isBarista() { return myRole() in ['barista', 'lead', 'shift']; }
    /** Mağaza müdürü ve vardiya müdürü. */
    function isLead() { return myRole() in ['lead', 'shift']; }
    function storeRoles() { return ['store', 'barista', 'lead', 'shift']; }
    /** Bölge müdürünün açıp kapatabildiği hesaplar: mağaza rolleri + derslik. */
    function manageableRoles() { return ['store', 'barista', 'lead', 'shift', 'derslik']; }
    /** Ekibe verilebilecek roller: Kahve Operasyon Direktörü kurul dahil ekibi kurar. */
    // Ekibe geliştirici eklenmez (tektir); geliştirici ekibin geri kalanını kurar.
    function teamRolesFor() { return isAdmin() ? ['director', 'opsmanager', 'regional', 'marketing', 'board'] : ['opsmanager', 'regional', 'marketing', 'board']; }
    function myStoreId() { return me().storeId; }
    function myBaristaId() { return me().baristaId; }
    function inStore(storeId) { return isStoreSession() && myStoreId() == storeId; }

    // --- Kullanıcı hesapları ------------------------------------------
    match /users/{uid} {
      // Uygulama geliştiricisinin belgesi yalnızca ona görünür:
      // direktör dahil kimse adını, e-postasını ya da rolünü okuyamaz. Ekip
      // listeleri bu yüzden sorguda rolü süzer (bkz. roles.ts visibleStaffRoles).
      allow get: if (isStaff() && (isAdmin() || resource == null || !(resource.data.role == 'developer')))
                 || (signedIn() && request.auth.uid == uid);
      // Mağaza telefonlarını ve Kahve Operasyonu ekibini listelemek için.
      allow list: if (isStaff() && (isAdmin() || !(resource.data.role == 'developer')))
        // Kurul, soru sorarken kime soracağını seçmek için direktörü ve bölge müdürünü görür.
        || (isBoard() && resource.data.role in ['director', 'opsmanager', 'regional'])
        // Pazarlama & Kreatif panelde ekip listesini görür (mağaza ve barista
        // hesaplarını değil; geliştirici hiç görünmez).
        || (isMarketing() && resource.data.role in ['director', 'opsmanager', 'regional', 'marketing', 'board']);
      // İlk kurulum: hiç yönetici yokken, yeni hesabın kendisi 'developer' (uygulama geliştiricisi) olarak kendi belgesini oluşturur.
      // Sonrasında: ekip hesaplarını Kahve Operasyon Direktörü, mağaza/barista
      // hesaplarını Bölge Müdürü açar. Kimse kendinden üst rol veremez.
      allow create: if userTextOk() && ((signedIn() && request.auth.uid == uid && request.resource.data.role == 'developer'
                          && !exists(/databases/$(database)/documents/config/bootstrap))
                      || (isDirector() && request.resource.data.role in teamRolesFor())
                      || (canManageBaristas() && request.resource.data.role in manageableRoles()));
      // Cihaz/barista hesapları kendi "son görülme" zamanını her girişte;
      // mağaza telefonu ayrıca eşleştirme kodunu kullandığında kendi
      // paired/label alanlarını günceller (bkz. backend.ts pairDevice).
      // Kendi belgesinde: label kısa metin, paired evet/hayır, lastSeenAt sayı
      // (rapor: barista kendi label'ına 200 KB yazabiliyordu).
      allow update: if isAdmin()
                      || (userTextOk() && (
                         (isDirector() && resource.data.role in teamRolesFor() && request.resource.data.role in teamRolesFor())
                      || (canManageBaristas() && resource.data.role in manageableRoles() && request.resource.data.role in manageableRoles())
                      || (signedIn() && request.auth.uid == uid && resource.data.get('active', false) == true
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt', 'paired', 'label', 'mustChangePassword'])
                          // Geçici şifre bayrağını yalnızca kapatabilir (açamaz).
                          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['mustChangePassword'])
                              || request.resource.data.mustChangePassword == false)
                          && request.resource.data.get('paired', false) is bool
                          && (request.resource.data.get('lastSeenAt', null) == null || request.resource.data.lastSeenAt is number))));
      allow delete: if false;
      function userTextOk() {
        return strMax(request.resource.data, 'name', 120) && strMax(request.resource.data, 'label', 80)
          && strMax(request.resource.data, 'email', 200);
      }
    }

    // İlk kurulum işareti. Herkes okur ("kurulum yapıldı mı"), içinde kimlik
    // yok: yalnızca { at }. Eskiden geliştiricinin uid'ini taşıyordu ve
    // oturumsuz okunabiliyordu (güvenlik raporu K-3). Belge yoksa bir kez,
    // aynı toplu yazımda kendini geliştirici yapan hesap oluşturur; sonra değişmez.
    match /config/bootstrap {
      allow get: if true;
      allow create: if signedIn() && !exists(/databases/$(database)/documents/config/bootstrap)
        && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at is number
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'developer';
      allow update, delete: if false;
    }

    // Yapay zekâ anahtarı (dosyadan ders üretimi, bkz. src/lib/aiLesson.ts).
    // Barista ve mağaza oturumları hiç okuyamaz.
    match /config/ai {
      // Yalnızca Kahve Operasyon Direktörü (ve geliştirici) okur: anahtar
      // istemciye düz iner, okuyan herkes onu dışarı taşıyabilir (güvenlik
      // raporu K-7, 15.11.2026 kararı; 14.11'deki ops/regional/opsmanager
      // okuması geri alındı).
      allow get: if isDirector();
      // Anahtarı yalnızca uygulama geliştiricisi yazar.
      allow write: if isAdmin();
    }

    // Rozet ve başarım ayarları: herkes okur, Kahve Operasyon Direktörü yazar.
    match /config/badges {
      allow get: if isActive();
      allow write: if canBadges();
    }

    // Yetki ayarları (Yetkiler ekranı): panel ve kurul okur; yalnızca Kahve
    // Operasyon Direktörü (ve geliştirici) yazar — bu kural ayarlanamaz.
    match /config/permissions {
      allow get: if canRead();
      allow write: if isDirector();
    }

    // Son yedek zamanı (src/lib/backup.ts, scripts/yedek.mjs): yalnızca
    // uygulama geliştiricisi okur ve yazar; içinde yalnızca { at } var.
    match /config/backup {
      allow get: if isAdmin();
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at is number;
    }

    // Demo kaydı (src/demo/log.ts). Yalnızca config/demo olan projede (demo,
    // emülatör) yazılır; canlı projede o belge yok, kimse yazamaz. Kayıtları
    // yalnızca uygulama geliştiricisi okur, kimse değiştirip silemez.
    match /config/demo {
      allow get: if isActive();
      allow write: if isAdmin();
    }
    match /demoLog/{id} {
      allow create: if signedIn()
        && exists(/databases/$(database)/documents/config/demo)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['at', 'uid', 'who', 'role', 'sid', 'device', 'kind', 'path', 'op', 'label', 'detail'])
        && request.resource.data.detail is string && request.resource.data.detail.size() <= 4000;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // E-posta bildirim ayarları (kim hangi olayda e-posta alır) ve gönderim
    // kaydı. Gönderimi sunucu (Cloud Functions, yönetici yetkisiyle) yapar.
    match /config/notifications {
      allow get: if isStaff();
      allow write: if canNotifications();
    }
    match /mailLog/{id} {
      allow read: if canNotifications();
      allow write: if false;
    }

    // Uygulama içi geri bildirim: her oturum (barista, mağaza telefonu,
    // operasyon) kendi adına gönderir; geliştirici, direktör ve bölge müdürü
    // okur, durumunu değiştirir. Silinmez: neyin bildirildiği kayıttır.
    match /feedback/{id} {
      // Alanlar src/features/shared/Feedback.tsx ile aynı; görsel yalnızca yüklenen data URL.
      // Derslik hesabı hariç: kodu bilen herkesin paylaştığı bir hesaptır,
      // geri bildirim kişiye bağlı olmalı (barista kendi PIN'iyle girince yazar).
      allow create: if isActive() && !isDerslik() && request.resource.data.by == request.auth.uid
        && request.resource.data.status == 'yeni'
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000
        && request.resource.data.keys().hasOnly(['kind', 'text', 'imageUrl', 'lessonId', 'lessonTitle', 'questionId', 'questionPrompt',
             'path', 'version', 'device', 'by', 'byName', 'role', 'storeName', 'status', 'createdAt'])
        && imgOk(request.resource.data)
        && strMax(request.resource.data, 'kind', 30) && strMax(request.resource.data, 'lessonId', 128)
        && strMax(request.resource.data, 'lessonTitle', 300) && strMax(request.resource.data, 'questionId', 128)
        && strMax(request.resource.data, 'questionPrompt', 300) && strMax(request.resource.data, 'path', 300)
        && strMax(request.resource.data, 'version', 120) && strMax(request.resource.data, 'device', 120)
        && strMax(request.resource.data, 'byName', 120) && strMax(request.resource.data, 'role', 30)
        && strMax(request.resource.data, 'storeName', 120);
      allow read: if canFeedback();
      allow update: if canFeedback()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'updatedAt'])
        && strMax(request.resource.data, 'note', 2000);
      allow delete: if false;
    }

    // Otomatik hata kaydı (src/lib/errorLog.ts): her oturum kendi adına
    // yazar, yalnızca uygulama geliştiricisi okur. Değiştirilmez; geliştirici
    // ele alınmış kayıtları temizleyebilir.
    //
    // Kota koruması (güvenlik raporu K-5): belge kimliği belirlenimci,
    // `<uid>_<YYYYAAGG>_<0..19>` (gün UTC; saat farkına karşı dün/bugün/yarın
    // kabul). Kayıt değiştirilemediği için aynı kimlik ikinci kez yazılamaz:
    // bir hesap bir günde en fazla 20 hata kaydı bırakabilir (bkz. errorLog.ts).
    match /hatalar/{id} {
      allow create: if signedIn() && request.resource.data.by == request.auth.uid
        && id.matches(request.auth.uid + '_(' + ymd(request.time) + '|' + ymd(request.time - duration.value(1, 'd'))
                      + '|' + ymd(request.time + duration.value(1, 'd')) + ')_([0-9]|1[0-9])')
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 2000
        && request.resource.data.keys().hasOnly(['kind', 'message', 'stack', 'extra', 'path', 'version', 'bundle', 'device', 'by', 'byName', 'role', 'storeName', 'createdAt'])
        && strMax(request.resource.data, 'kind', 10) && strMax(request.resource.data, 'extra', 1000)
        && strMax(request.resource.data, 'path', 200) && strMax(request.resource.data, 'version', 100)
        && strMax(request.resource.data, 'bundle', 100) && strMax(request.resource.data, 'device', 120)
        && strMax(request.resource.data, 'byName', 120) && strMax(request.resource.data, 'role', 30)
        && strMax(request.resource.data, 'storeName', 120);
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /stores/{storeId} {
      allow read: if isActive();
      // Kendi mağazası pasif olsa da okunur: uygulama "mağaza pasif" ekranını gösterir (H7).
      allow get: if signedIn() && me().get('active', false) == true && me().get('storeId', null) == storeId;
      allow write: if canManageBaristas();
    }

    match /baristas/{baristaId} {
      allow read: if canRead() || inStore(resource.data.storeId)
        || (isDerslik() && resource.data.storeId == myStoreId());
      allow create, delete: if canManageBaristas();
      // Davet kodunu kullanan barista kendi "pinPending" bayrağını kapatır
      // (bkz. backend.ts redeemInvite); başka her şeyi Bölge Müdürü değiştirir.
      // Önlük rozeti teslimini Kahve Operasyon Direktörü de işaretler.
      allow update: if canManageBaristas()
        || (canBadges() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['apronBadge', 'apronBadgeAt', 'apronBadgeByName', 'badgeOverrides']))
        || (isBarista() && myBaristaId() == baristaId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinPending']));
    }

    // --- İçerik: herkes okur, Kahve Operasyon Direktörü yayınlar ------------
    // Bölge müdürü ve ekip doğrudan yazamaz; değişiklikleri proposals'a
    // düşer (bkz. src/api/changes.ts).
    // Alan sınırı: Operasyon Müdürü yalnızca kendi eğitim yollarına yazar
    // (kahve dışı); diğer yollardaki değişikliği öneri olarak gönderir.
    // Eğitim yolu (track) eklemek/silmek alan sınırı olmayanlara açıktır.
    //
    // Alan denetimi hem yazım sonrası hâle hem (varsa) eski hâle bakar: alan
    // dışı bir dersi kendi modülüne "taşıyarak" değiştirmek de alan dışıdır.
    match /tracks/{id} {
      allow read: if isActive();
      allow write: if (isAdmin() || (canPublish() && domainLimit() == null)) && trackTextOk();
    }
    match /modules/{id} {
      allow read: if isActive();
      allow write: if (isAdmin() || (canPublish() && inTrack(docData().trackId) && (resource == null || inTrack(resource.data.trackId))))
        && trackTextOk();
    }
    /** Yol ve modül: başlık ve açıklama. */
    function trackTextOk() {
      return !onWrite() || (strMax(request.resource.data, 'title', 200) && strMax(request.resource.data, 'description', 2000));
    }
    // Ders gövdesi blok listesidir (görseller data URL olarak içinde); blok
    // sayısı sınırlanır, toplam boyutu Firestore'un 1 MiB belge sınırı keser.
    match /lessons/{id} {
      allow read: if isActive();
      allow write: if (isAdmin() || (canPublish() && inModule(docData().moduleId) && (resource == null || inModule(resource.data.moduleId))))
        && (!onWrite() || (strMax(request.resource.data, 'title', 300) && listMax(request.resource.data, 'blocks', 300)));
    }
    // Soru bankası: sunucu olmadığı için sınav telefonda puanlanır, bu
    // yüzden mağaza oturumları da okuyabilmek zorunda (cevap anahtarı dahil).
    match /questions/{id} {
      // Pazarlama & Kreatif akademiyi okur: modül ekranındaki soru bankası da
      // görünür (yazma yetkisi yok, aşağıdaki write kuralı kapsamaz).
      allow read: if isStaff() || isMarketing() || isStoreSession();
      allow write: if (isAdmin() || ((canPublish() || canFixQuestions()) && inModule(docData().moduleId) && (resource == null || inModule(resource.data.moduleId))))
        && imgWriteOk()
        && (!onWrite() || (strMax(request.resource.data, 'prompt', 1000) && strMax(request.resource.data, 'explanation', 3000)
            && listMax(request.resource.data, 'options', 12)));
    }

    // --- Onay bekleyen değişiklikler ------------------------------------
    //
    // Önerinin `ops` listesindeki koleksiyonlar burada DENETLENEMİYOR: kurallar
    // dilinde döngü yok, liste öğe öğe açık yazılarak denetlenebilir; ölçümde
    // öğe başına ~16 ifade gidiyor ve istek başına 1000 ifade sınırı ~50 öğede
    // doluyor. Meşru öneriler bundan uzun olabilir (yeni ürün: mağaza başına
    // bir görev; dosyadan ders: onlarca soru). Koruma, onayın yürüdüğü yerde:
    // src/api/changes.ts yalnızca içerik koleksiyonlarını (beyaz liste)
    // yazar, tanımadığı işlemi içeren öneriyi yayınlamaz (güvenlik raporu K-1).
    match /proposals/{id} {
      allow read: if canRead();
      allow create: if ((isStaff() && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'pending') || isAdmin()) && proposalTextOk();
      // Müdür onaylar/reddeder (ve düzeltip yayınlarken ops'u günceller).
      // Öneri sahibi, bekleyen önerisini düzenler ya da geri çeker.
      allow update: if (canApproveProposals()
        || (isStaff() && resource.data.createdBy == request.auth.uid && resource.data.status == 'pending'
            && request.resource.data.status in ['pending', 'withdrawn']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ops', 'title', 'summary', 'updatedAt', 'status', 'baseUpdatedAt'])))
        && proposalTextOk();
      allow delete: if isAdmin();
      function proposalTextOk() {
        return request.resource.data.get('ops', []) is list
          && strMax(request.resource.data, 'title', 300) && strMax(request.resource.data, 'summary', 500)
          && strMax(request.resource.data, 'reviewNote', 2000) && strMax(request.resource.data, 'createdByName', 120);
      }
    }

    // --- Mağaza talepleri ----------------------------------------------
    // Mağaza / vardiya müdürü açar ve yazar; Bölge Müdürü ve Kahve Operasyon
    // Müdürü durumunu değiştirir. Silinmez: "sözlü talep geçersiz", kayıt kalır.
    match /requests/{id} {
      allow read: if canRead() || (isLead() && resource.data.storeId == myStoreId())
        // Kişiye bağlı PIN sıfırlama talebi o kişiye görünür (kodu kullanınca kapatır; H20).
        || (isBarista() && resource.data.get('subjectBaristaId', null) == myBaristaId());
      // Talep boş geçmişle açılır; başlık/ayrıntı sınırlı, görsel yalnızca yüklenen data URL (K-5).
      allow create: if ((isLead() && request.resource.data.storeId == myStoreId()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'open' && request.resource.data.lastSide == 'store'
        && request.resource.data.get('notes', []) == [])
        || isAdmin()) && requestTextOk();
      // Servis onayı bekleyen talebi yalnızca onay yetkisi olan bu durumdan
      // çıkarır; yanıt yetkisi olan "İşleme al" ile onayı atlayamaz (mesaj yazabilir).
      allow update: if requestTextOk() && ((canHandleRequests()
            // Konu sınırlı rol (Pazarlama & Kreatif) yalnızca kendi
            // konusundaki talebi yanıtlar; konu da değiştirilemez.
            && inReqCat(resource.data.category) && request.resource.data.category == resource.data.category
            && (resource.data.status != 'approval' || request.resource.data.status == 'approval' || canApproveService()))
        // Mağaza tarafı kapanmış (çözüldü/reddedildi) talebe yazamaz: talep
        // kapalı kaldığı için mesaj panelde "Açık" listesine düşmüyor, gözden
        // kaçıyordu. Yeni konu için yeni talep açılır (14.11.2026 kararı).
        // Mağaza notları yalnızca SONA eklenir: eski notlar (operasyonun
        // yanıtları dahil) aynen kalır, eklenen not mağazanın ve yazanın
        // kendisinin (K-4: notes dizisini baştan yazıp sahte "ops" yanıtı).
        || (isLead() && resource.data.storeId == myStoreId()
            && !(resource.data.status in ['done', 'rejected'])
            && request.resource.data.lastSide == 'store'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes', 'updatedAt', 'lastSide'])
            && appended(request.resource.data.notes, resource.data.get('notes', []), 'store', 3000)
            && request.resource.data.notes[resource.data.get('notes', []).size()].keys().hasOnly(['at', 'by', 'byName', 'side', 'text']))
        // Kişiye bağlı PIN sıfırlama talebi: o kişi yeni koduyla PIN belirleyince
        // talebi "çözüldü" yapar (H20). Yalnızca açık kişisel talep, yalnızca
        // kapatma; eklenen not o kişinin ve mağaza tarafının.
        || (isBarista() && resource.data.get('subjectBaristaId', null) == myBaristaId()
            && resource.data.category == 'personel' && !(resource.data.status in ['done', 'rejected'])
            && request.resource.data.status == 'done' && request.resource.data.lastSide == 'store'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closedAt', 'updatedAt', 'lastSide', 'waitReason', 'notes'])
            && appended(request.resource.data.notes, resource.data.get('notes', []), 'store', 300)
            && request.resource.data.notes[resource.data.get('notes', []).size()].keys().hasOnly(['at', 'by', 'byName', 'side', 'text', 'status'])));
      allow delete: if isAdmin();
      function requestTextOk() {
        return strMax(request.resource.data, 'title', 300) && strMax(request.resource.data, 'detail', 5000)
          && strMax(request.resource.data, 'equipment', 100) && strMax(request.resource.data, 'storeName', 120)
          && strMax(request.resource.data, 'createdByName', 120) && listMax(request.resource.data, 'notes', 500)
          && imgWriteOk();
      }
    }

    // --- Sonuçlar ----------------------------------------------------
    match /attempts/{id} {
      allow read: if canRead()
        || (isBarista() && resource.data.baristaId == myBaristaId())
        || (isLead() && resource.data.storeId == myStoreId());
      // Sınav başlatma işlemi (exam.ts startExam) belirlenimci kimliğin boş
      // olup olmadığına bakar: aynı barista + modül için iki cihazdan aynı
      // anda "Başla" iki deneme açmasın. Var olmayan belgeyi okumak bir şey sızdırmaz.
      allow get: if isBarista() && resource == null;
      // Kimlik baristanın kendi ad alanında olmalı (`<baristaId>_<modül>_…`,
      // bkz. exam.ts startExam): başkası kurbanın belirlenimci kimliklerini
      // önceden kapıp onun sınav başlatmasını kilitleyemesin (güvenlik raporu
      // K-10). Şube kendi şubesi; puan alanları açılışta yazılamaz.
      // Süre (H1): başlangıç sunucu saatine ±5 dk yakın, son teslim soru
      // başına 90 sn (exam.ts SECONDS_PER_QUESTION). Telefonun saati 2 gün
      // ileri/3 saat geri olsa da deneme sunucu saatiyle açılır.
      allow create: if (isBarista() && request.resource.data.baristaId == myBaristaId()
        && id.split('_')[0] == myBaristaId()
        && request.resource.data.storeId == myStoreId()
        && nearNow(request.resource.data.startedAt, 300000)
        && request.resource.data.total is int && request.resource.data.total > 0 && request.resource.data.total <= 100
        && request.resource.data.deadline == request.resource.data.startedAt + request.resource.data.total * 90000
        && request.resource.data.submittedAt == null
        && !request.resource.data.keys().hasAny(['score', 'passed', 'correct', 'mistakes', 'voided', 'timedOut', 'regradedAt', 'voidedQuestions']))
        // Geliştirici: demo ortamına örnek sınav geçmişi yazmak için.
        || isAdmin();
      // Puanlama telefonda. Deneme açıkken (submittedAt == null) barista
      // cevaplarını kaydeder; bir kez de puanlayıp kapatır. Kapandıktan
      // sonra hiçbir alan değişmez.
      // total/voidedQuestions: teslimde iptal edilen ya da bankadan silinen
      // sorular hesap dışı kalır, toplam da buna göre yazılır.
      //
      // Süre sunucuda (H1): son teslimden 2 dk sonrasına kadar cevap yazılır.
      // Sonra cevaplar değişmez ve deneme yalnızca "süre doldu" ya da
      // "geçersiz" olarak, o ana kadar kaydedilmiş cevaplarla kapanır (saat
      // geri alınarak süresi geçmiş sınav "geçti" diye teslim edilemez).
      // Teslim anı sunucu saatini geçemez, başlangıçtan önce olamaz.
      // storeId: sınav sırasında başka şubeye taşınan barista sonucu güncel
      // şubesine yazar (H8); başka bir şubeye yazamaz.
      allow update: if isBarista() && resource.data.baristaId == myBaristaId()
        && resource.data.submittedAt == null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['answers', 'submittedAt', 'correct', 'score', 'passed', 'mistakes', 'timedOut', 'voided', 'total', 'voidedQuestions', 'storeId'])
        && (request.resource.data.storeId == resource.data.storeId || request.resource.data.storeId == myStoreId())
        && attemptOnTime();
      function attemptOnTime() {
        let late = resource.data.get('deadline', null) is number && request.time.toMillis() > resource.data.deadline + 120000;
        let closing = request.resource.data.get('submittedAt', null) != null;
        return (!late || (request.resource.data.get('answers', null) == resource.data.get('answers', null)
                          && (!closing || request.resource.data.get('timedOut', false) == true || request.resource.data.get('voided', false) == true)))
          && (!closing || (request.resource.data.submittedAt is number
                           && request.resource.data.submittedAt <= request.time.toMillis() + 300000
                           && request.resource.data.submittedAt >= resource.data.get('startedAt', 0)));
      }
      // Hatalı soru iptal edilince Kahve Operasyon Direktörü geçmiş sınavları
      // o soru olmadan yeniden puanlar (Soru havuzu); yalnızca puan alanları.
      allow update: if canFixQuestions() && resource.data.submittedAt != null && (isAdmin() || inModule(resource.data.moduleId))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['score', 'passed', 'correct', 'total', 'mistakes', 'regradedAt', 'regradeNote', 'voidedQuestions']);
      // İptal anında açık olan denemeye yalnızca "bu soru iptal" notu düşülür;
      // barista teslim edince soru buna göre puanlanır (bkz. exam.ts submitExam).
      allow update: if canFixQuestions() && resource.data.submittedAt == null && (isAdmin() || inModule(resource.data.moduleId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voidedQuestions']);
      // Sınav geçmişi kayıttır: ne barista ne de operasyon silebilir.
      // Yalnızca geliştirici, hatalı/deneme kayıtlarını temizlemek ve demo
      // ortamını sıfırlamak için silebilir.
      allow delete: if isAdmin();
    }

    match /progress/{baristaId} {
      allow read: if canRead() || inStore(resource.data.storeId);
      allow create: if canManageBaristas();
      // Barista hem ders tamamlamalarını hem (sunucu olmadığı için) kendi
      // sınav sonucunu yazar; sadece kendi belgesine, sadece bu alanlara.
      allow update: if canManageBaristas() || canFixQuestions()
        || (isBarista() && myBaristaId() == baristaId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lessons', 'modules', 'bulletins', 'quizzes', 'theme', 'updatedAt']));
      allow delete: if false;
    }

    // --- Bülten -------------------------------------------------------
    // Kahve Operasyon Direktörü yayınlar (diğerleri öneri yapar), mağaza
    // oturumları okur.
    //
    // Mağaza hedeflemesi (storeIds) güvenlik sınırı DEĞİL, görünürlük
    // tercihidir: liste sorgusunu kurallarla mağazaya daraltmak, "tüm
    // mağazalar" anlamına gelen null değerini de kapsayan ikinci bir sorgu
    // gerektirirdi. Bülten içeriği zaten şirket içi duyuru; hedefleme
    // arayüzde uygulanıyor.
    match /bulletins/{id} {
      allow read: if canRead() || isStoreSession();
      allow create, update: if canPublishBulletin() && request.resource.data.createdBy is string
        && strMax(request.resource.data, 'title', 300) && strMax(request.resource.data, 'body', 10000)
        && strMax(request.resource.data, 'createdByName', 120) && imgWriteOk();
      allow delete: if canPublishBulletin();
    }

    // --- Görevler ------------------------------------------------------
    match /assignments/{id} {
      allow read: if canRead() || inStore(resource.data.storeId);
      // Belirli bir baristaya atanan görev o baristanın şubesine açılır
      // (müdür başka şubenin baristasına görev yazamaz).
      allow create: if ((((isStaff() && canAssign()) || (isLead() && request.resource.data.storeId == myStoreId()))
        && request.resource.data.createdBy == request.auth.uid
        && (request.resource.data.get('baristaId', null) == null
            || get(/databases/$(database)/documents/baristas/$(request.resource.data.baristaId)).data.storeId == request.resource.data.storeId))
        || isAdmin()) && assignmentTextOk();
      // Görevi atayan değiştirir/siler; Kahve Operasyon Direktörü herkesinkini.
      // Görevin şubesi ve baristası sonradan değişmez (güvenlik raporu K-4:
      // müdür kendi görevini başka şubeye taşıyıp oraya metin sokuyordu).
      // Uygulamada görev düzenleme yok; şube değişecekse görev silinip yeniden atanır.
      allow update: if (isDirector()
          || (isStaff() && resource.data.createdBy == request.auth.uid)
          || (isLead() && resource.data.storeId == myStoreId() && resource.data.createdBy == request.auth.uid))
        && request.resource.data.storeId == resource.data.storeId
        && request.resource.data.get('baristaId', null) == resource.data.get('baristaId', null)
        && assignmentTextOk();
      allow delete: if isDirector()
        || (isStaff() && resource.data.createdBy == request.auth.uid)
        || (isLead() && resource.data.storeId == myStoreId() && resource.data.createdBy == request.auth.uid);
      function assignmentTextOk() {
        return strMax(request.resource.data, 'title', 300) && strMax(request.resource.data, 'note', 1000)
          && strMax(request.resource.data, 'createdByName', 120);
      }
    }

    // --- Telefon eşleştirme (tek kullanımlık, kısa ömürlü) --------------
    // Kod, telefon henüz oturum açmadan önce okunur — düz metin şifre
    // taşıdığı için 30 dk'lık ömrü ve tek kullanımlık doğası tek korumadır.
    match /pairingCodes/{code} {
      // Var olmayan kod reddedilir: oturumsuz biri "bu kod var mı" diye
      // deneme yapamasın (güvenlik raporu K-6, 15.11.2026 kararı). Kod
      // üretirken çakışma denetimini (backend.ts uniqueCode) barista yönetimi
      // yetkisi olan yapar; ona var olmayan kod da okunur.
      allow get: if canManageBaristas() || (resource != null && resource.data.expiresAt > request.time.toMillis());
      // Ömür sunucu saatiyle EN ÇOK 7 gün (H2; 16.11.2026'ya kadar 30 dk). Kodlar
      // mağazalara yazılı iletilebilsin diye uzatıldı; tek kullanımlık (telefon
      // kullanınca siler). Kod düz metin şifre taşır: yanlış ele geçen kod
      // panelden telefon kaldırılarak geçersizleşir. Alt sınır 25 dk: eski
      // (30 dk yazan) panel de çalışmayı sürdürür.
      allow create: if canManageBaristas() && request.resource.data.expiresAt is number
        && request.resource.data.expiresAt >= request.time.toMillis() + 1500000
        && request.resource.data.expiresAt <= request.time.toMillis() + 604800000 + 300000;
      // Kodu yalnızca onunla eşleşen telefon (kullanınca) ya da Bölge Müdürü siler.
      allow delete: if (isActive() && resource.data.uid == request.auth.uid) || canManageBaristas();
      allow update: if false;
    }

    // --- Barista daveti (7 gün, tek kullanımlık) ------------------------
    match /invites/{code} {
      // Davet (e-posta + geçici şifrenin türetildiği kod) yalnızca kendi
      // şubesinin oturumuna (telefon, kodu kullanırken) ve barista yönetimi
      // yetkisi olana görünür. Eskiden her mağaza oturumu başka şubenin
      // davetini okuyup o baristanın hesabını devralabiliyordu (K-2).
      // Var olmayan kod mağaza oturumuna da reddedilir (kahin olmasın);
      // yeni kod üretirken çakışma denetimini barista yöneticisi yapar.
      // Süresi dolmuş davet mağaza oturumuna okunmaz (sunucu saatiyle; H2).
      allow get: if canManageBaristas() || (isStoreSession() && resource.data.storeId == myStoreId()
        && resource.data.get('expiresAt', 0) > request.time.toMillis());
      // Eski davetleri temizlerken (PIN sıfırlama, işten çıkarma) sorgulanır.
      allow list: if canManageBaristas();
      // Ömür sunucu saatiyle 7 gün (H2).
      allow create: if canManageBaristas() && nearNow(request.resource.data.expiresAt - 604800000, 300000);
      // Mağaza oturumu yalnızca kendi mağazasının davetini siler (kullanınca).
      allow delete: if (isStoreSession() && resource.data.storeId == myStoreId()) || canManageBaristas();
      // Barista başka mağazaya taşınınca bekleyen davet de taşınır (backend.ts updateBarista).
      allow update: if canManageBaristas() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['storeId']);
    }

    // --- Sunucu saati ölçümü (src/lib/serverTime.ts) --------------------
    // Her hesap yalnızca kendi belgesine, yalnızca sunucu zamanını yazar
    // (serverTimestamp). İçinde ad ya da rol yok, yalnızca zaman.
    //
    // Bu yazım her oturum açılışında bir kez, sonra etkin kullanımda 30
    // dakikada bir olur (REFRESH_MS) — yani belge, o hesabın son etkinlik
    // anıdır. Kullanım raporu (npm run kullanim) bunu okur: users.lastSeenAt
    // yalnızca mağaza telefonunda tutuluyor, bu ise her rolde var.
    // Geliştirici dışında kimse başkasınınkini okuyamaz.
    match /clock/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, update: if isActive() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
    }

    // --- Kullanım sayacı (src/lib/kullanimKaydi.ts) ----------------------
    // Mağaza başına, gün başına TEK belge: kullanim/{storeId}_{YYYYAAGG}.
    // İçinde uid, ad ya da barista kimliği YOK — kişisel veri değil, mağaza
    // düzeyinde toplu istatistiktir (KVKK: docs/KVKK-AYDINLATMA-TASLAK.md).
    // Yalnızca o mağazanın etkin oturumu yazar, yalnızca bugünün belgesine;
    // sayaçlar ve anahtar sayıları üstten sınırlı. Yalnızca geliştirici okur.
    //
    // Kişi bazlı kayıt (kullanim/{uid}_{gün}) BİLİNÇLİ OLARAK KAPALI: açmak
    // için hem kullanimKaydi.ts'teki KISI_BAZLI sabiti hem buradaki kimlik
    // kuralı değişmeli, ve ikisi de KVKK metni onaylanmadan açılmamalı.
    match /kullanim/{id} {
      allow read: if isAdmin();
      allow create, update: if isStoreSession() && isActive()
        && id == myStoreId() + '_' + ymd(request.time)
        && request.resource.data.keys().hasOnly(['storeId', 'day', 'acilis', 'saatler', 'ekran', 'recete', 'updatedAt'])
        && request.resource.data.storeId == myStoreId()
        && request.resource.data.day == ymd(request.time)
        && nearNow(request.resource.data.updatedAt, 10 * 60 * 1000)
        && request.resource.data.get('acilis', 0) is int
        && request.resource.data.get('acilis', 0) >= 0
        && request.resource.data.get('acilis', 0) <= 5000
        && request.resource.data.get('saatler', {}).keys().size() <= 24
        && request.resource.data.get('ekran', {}).keys().size() <= 20
        && request.resource.data.get('recete', {}).keys().size() <= 40;
      allow delete: if isAdmin();
    }

    // --- Evde ders çalışma kodu (derslikKodlari) -------------------------
    // Mağaza başına tek kod. Kodu bilen giriş yapmadan okuyabilir —
    // pairingCodes ile aynı desen (kodu bilmek kanıttır, var olmayan kod
    // reddedilir ki oturumsuz biri kod taraması yapamasın). Belge PIN ya da
    // barista şifresi taşımaz; yalnızca sınırlı "derslik" hesabının kimliği.
    // Kod sızarsa panelden yenilenir: yeni kod yazılır, eski hesap pasifleşir.
    match /derslikKodlari/{code} {
      allow get: if canManageBaristas() || resource != null;
      allow list: if canManageBaristas();
      allow create, update: if canManageBaristas()
        && request.resource.data.keys().hasOnly(['code', 'storeId', 'storeName', 'uid', 'email', 'password', 'createdAt', 'createdByName'])
        && request.resource.data.code == code
        && request.resource.data.storeId is string
        && strMax(request.resource.data, 'storeName', 120)
        && strMax(request.resource.data, 'email', 200)
        && strMax(request.resource.data, 'password', 100)
        && strMax(request.resource.data, 'createdByName', 120)
        && nearNow(request.resource.data.createdAt, 10 * 60 * 1000);
      allow delete: if canManageBaristas();
    }

    // --- Yönetim Kurulu soruları ----------------------------------------
    // Kurul üyesi sorar; direktör ve bölge müdürü yanıtlar. Kurulun bütün
    // üyeleri bütün soruları görür. Silinmez: sorulan ve verilen yanıt kayıttır.
    match /boardQuestions/{id} {
      allow read: if isBoard() || seesBoard();
      allow create: if isBoard() && perm('kurul.sorular', ['board']) && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'open' && request.resource.data.lastSide == 'board'
        && request.resource.data.to in ['director', 'opsmanager', 'regional', 'all']
        && request.resource.data.messages.size() == 1
        && appended(request.resource.data.messages, [], 'board', 3000)
        && strMax(request.resource.data, 'createdByName', 120)
        && (!('topic' in request.resource.data) || strMax(request.resource.data.topic, 'title', 200));
      // Yazışma yalnızca sona eklenir; eski mesajlar (karşı tarafın yanıtı
      // dahil) değiştirilemez. Kurul: ek soru yazar ya da "tamam" deyip kapatır
      // (kapatırken mesaj eklenmez).
      allow update: if (isBoard() && request.resource.data.lastSide == 'board'
            && request.resource.data.status in ['open', 'closed']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messages', 'status', 'lastSide', 'updatedAt'])
            && (request.resource.data.messages == resource.data.messages
                || appended(request.resource.data.messages, resource.data.messages, 'board', 3000)))
        // Operasyon: yanıtlar (soru "yanıtlandı" olur).
        || (answersBoard() && request.resource.data.lastSide == 'ops'
            && request.resource.data.status == 'answered'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messages', 'status', 'lastSide', 'updatedAt'])
            && appended(request.resource.data.messages, resource.data.messages, 'ops', 3000));
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
